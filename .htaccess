# Integrar este bloque con las reglas existentes del hosting.
<FilesMatch "^\.env($|\.)">
    Require all denied
</FilesMatch>
Options -MultiViews
RewriteEngine On
RewriteRule ^config/(?!envio_correo\.php$) - [F,L]
RewriteRule ^(?:vendor|tools)/ - [F,L]
RewriteRule ^composer\.(?:json|lock)$ - [F,L]
RewriteRule ^blog\.html$ /blog [R=301,L]
RewriteRule ^blog(?:/.*)?$ blog/index.php [END,QSA]
